{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::BUCKET_RAW",
        "arn:aws:s3:::BUCKET_ARTIFACTS"
      ]
    },
    {
      "Sid": "ReadObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_RAW/*",
        "arn:aws:s3:::BUCKET_ARTIFACTS/*"
      ]
    }
  ]
}
