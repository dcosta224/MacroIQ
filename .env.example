# Supabase pooled Postgres connection (same vars as lib/server/db.ts getSql())
PG_DATABASE=postgres
PG_PASSWORD=<PASSWORD>
PG_SSL_MODE=require

# Transaction pooler — port 6543. `psql` / scratch/foundation_all_food_april2026.py use this by default
# (session port 5432 often rejects the same DB password on Supavisor).
PG_POOL_USER=postgres.<organization-ref>
PG_POOL_HOST=aws-1-us-east-1.pooler.supabase.com
PG_POOL_TRANSACTION_PORT=6543
PG_POOL_SESSION_PORT=5432
PG_PSQL_USE_TRANSACTION_POOLER_PORT=1

# Optional: session pooler port (usually 5432). Only set PG_PSQL_USE_SESSION_POOLER_PORT=1 if 5432 auth works.

# MVP web app — LLM judge (optional; mock judge used if unset)
# OPENAI_API_KEY=sk-...
# OPENAI_API_KEY_2=sk-...
# HF_TOKEN=hf_...

# MVP Strands agent — Bedrock orchestrator (aws login profile; judge still uses OpenAI)
# AWS_REGION=us-east-1
# AWS_PROFILE=
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# MVP_AGENT_ENABLED=1

# LangSmith observability for recipe_opt_agent (see docs/recipe_opt_agent_langsmith.md)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=recipe-opt-agent-eval
# Legacy aliases also work: LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT


# Force pooler in URL builder even when direct resolves (rare):
# PG_PSQL_SESSION_POOLER=1

# Direct db.<project-ref>.supabase.co (Dashboard → Connect). Without IPv4 add-on this is often IPv6-only.
# After enabling IPv4 add-on, DNS may take a few minutes; if diagnose still shows direct BAD, flush macOS
# DNS (dscacheutil + mDNSResponder) and confirm `dig +short A db.<ref>.supabase.co @8.8.8.8` shows an A record.
PG_DIR_USER=postgres
PG_DIR_DATABASE=postgres
PG_DIR_HOST=db.<organization-ref>.supabase.co
PG_DIR_PORT=5432

# Hugging Face Hub — https://huggingface.co/settings/tokens (read access is enough)
HF_TOKEN=<your-hf-token>

# OpenAI — https://platform.openai.com/api-keys (used by scripts/ingredient_match_llm.py)
# Calls alternate between keys (~2× throughput). On rate limit, the blocked key is skipped for the rest of the run.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_API_KEY_2=<your-second-openai-api-key>

# --- Launch / auth hooks (site stays local until you create a runtime) ---
# Leave AUTH_ENABLED=0 for now. /health -> launch reports readiness.
# AUTH_ENABLED=0

# Cognito (fill in when the user pool exists; unused while AUTH_ENABLED=0)
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=